# Référence des variables de l'API. Copier en `.env` et remplir.
# Aucune vraie valeur ici : ce fichier est versionné.
# Le détail de chaque variable est documenté dans `start/env.ts`.

# ── Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Application
# `node ace generate:key` pour en produire une.
APP_KEY=
APP_URL=http://localhost:3333
APP_NAME=RESI
# Site public, sans barre finale. Absent : page de retour minimale de l'API.
SITE_URL=

# ── Sécurité HTTP
# Origines navigateur autorisées en production, séparées par des virgules.
# Vide : aucune (le mobile est natif, le back-office passe par son serveur).
CORS_ALLOWED_ORIGINS=
# Proxys dont X-Forwarded-For fait foi : nombre de sauts (`1`) ou plages
# (`loopback,uniquelocal`). Indispensable derrière le proxy de l'hébergeur,
# sinon tous les clients partagent la même IP — et la même limite de débit.
# `true` est refusé.
TRUST_PROXY=

# ── Journal d'audit : conservation en jours (180 par défaut), purge par le
# TTL Firestore sur `audit_logs.expires_at`.
AUDIT_LOG_RETENTION_DAYS=

# ── Session
SESSION_DRIVER=cookie

# ── JWT
# 32 caractères au moins en production, deux valeurs distinctes :
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Firebase
# Compte de service au format JSON intégral, sur une ligne. Absent : ADC
# (`GOOGLE_APPLICATION_CREDENTIALS`).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://<projet>-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=

# ── Google Sign-In : client_id Android, iOS et web, séparés par des virgules
GOOGLE_CLIENT_IDS=

# ── Cloudinary (pièces d'identité, photos d'annonces)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DOCUMENTS_FOLDER=resi/owner-documents
CLOUDINARY_PROPERTIES_FOLDER=resi/properties

# ── Rapports PDF : chemin de Chromium (renseigné par l'image Docker)
PUPPETEER_EXECUTABLE_PATH=

# ── Tâches planifiées
# Secret des routes /api/v1/cron/*. Absent : ces routes sont refusées.
CRON_SECRET=
ENABLE_CRON_JOBS=false
CRON_TIMEZONE=Africa/Abidjan
CRON_STAY_STATUSES_SCHEDULE=
CRON_SUBSCRIPTION_REMINDERS_SCHEDULE=
CRON_EXPIRE_TRIALS_SCHEDULE=
CRON_PURGE_SESSIONS_SCHEDULE=

# ── Administrateurs créés au démarrage (JSON) — secret de l'hébergeur
# [{"full_name":"…","email":"…","password":"…"}]
BOOTSTRAP_ADMINS=

# ── Wave
WAVE_API_KEY=
WAVE_BASE_URL=https://api.wave.com
# Absent en production : tout webhook est refusé.
WAVE_WEBHOOK_SECRET=
WAVE_API_SIGNING_SECRET=
WAVE_CURRENCY=XOF
# Banc d'essai /admin/wave-test en production (vrais paiements). Fermé par défaut.
WAVE_TEST_ENABLED=false

# ── Quotas d'authentification par identifiant (RTDB)
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# ── E-mails (OTP). `console` est refusé en production.
MAIL_PROVIDER=console
MAIL_FROM=Resi <no-reply@example.com>
MAIL_REPLY_TO=
MAIL_TEMPLATE_OTP_VERIFICATION=
MAIL_TEMPLATE_EMAIL_VERIFIED=
MAIL_APP_URL=
MAIL_SUPPORT_EMAIL=
RESEND_API_KEY=

# ── SMS / WhatsApp
MESSAGING_PROVIDER=console
MESSAGING_PREFERRED_CHANNEL=sms
SMS_SENDER_ID=

AT_API_KEY=
AT_USERNAME=
AT_SMS_FROM=
AT_WHATSAPP_FROM=
AT_BASE_URL=
AT_WHATSAPP_BASE_URL=

INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=

ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
ORANGE_SENDER_NAME=
ORANGE_BASE_URL=

BOTTOMLINE_BASE_URL=
BOTTOMLINE_API_KEY=
BOTTOMLINE_WHATSAPP_FROM=
