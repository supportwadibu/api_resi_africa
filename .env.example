# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Google Sign-In
#--------------------------------------------------------------------
# Audiences acceptées pour l'ID token Google, séparées par des virgules.
# Renseigner TOUS les client_id OAuth utilisés par les clients :
#   - Android  : client_id de type "Android" (console Google Cloud)
#   - iOS      : client_id de type "iOS"
#   - Web      : client_id de type "Web" — requis par google_sign_in sur Android
#                comme serverClientId pour obtenir un idToken.
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com

#--------------------------------------------------------------------
# Tâches planifiées (cron)
#--------------------------------------------------------------------
# Secret protégeant /api/v1/cron/*, appelées par un ordonnanceur externe
# (cron-job.org, Cloud Scheduler). Transmis en en-tête `X-Cron-Secret` ou en
# query `?secret=`.
#
# Sans cette variable les routes répondent 503 : elles déclenchent des
# écritures en masse et ne doivent jamais être ouvertes par défaut.
# Générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

#--------------------------------------------------------------------
# Firebase (Firestore + Realtime Database)
#--------------------------------------------------------------------
# Compte de service, JSON intégral sur une seule ligne.
# À laisser vide en local : poser GOOGLE_APPLICATION_CREDENTIALS vers le
# fichier .json suffit, le SDK le lit tout seul.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"resi-5c32a",...}

# Realtime Database — obligatoire : les OTP et les tentatives d'authentification
# y sont stockés, donc l'inscription et le rate-limit en dépendent.
# L'URL dépend de la région de l'instance :
#   us-central1  -> https://<id>-default-rtdb.firebaseio.com
#   europe-west1 -> https://<id>-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=https://resi-5c32a-default-rtdb.firebaseio.com

# Utile uniquement sans compte de service explicite (mode ADC).
FIREBASE_PROJECT_ID=resi-5c32a

#--------------------------------------------------------------------
# Cloudinary — pièces d'identité des propriétaires et photos d'annonces
#--------------------------------------------------------------------
# Valeurs relevées sur le tableau de bord Cloudinary (Settings > API Keys).
# Les justificatifs sont déposés en mode `authenticated` : ils ne sont jamais
# accessibles par URL publique, seulement par des URLs signées de 15 minutes.
# Les photos d'annonces sont au contraire publiques (`upload`) : elles sont
# affichées telles quelles dans l'application cliente.
# CLOUDINARY_API_SECRET est un secret serveur : il ne doit jamais être exposé
# à l'application mobile.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optionnel — dossier racine des justificatifs dans le compte Cloudinary.
# CLOUDINARY_DOCUMENTS_FOLDER=resi/owner-documents
# Optionnel — dossier racine des photos d'annonces.
# CLOUDINARY_PROPERTIES_FOLDER=resi/properties