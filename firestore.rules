rules_version = '2';

/**
 * Règles de sécurité Firestore.
 *
 * Toutes les données de cette base sont écrites et lues par l'API AdonisJS,
 * qui s'authentifie avec un compte de service. Les comptes de service
 * *contournent* les règles de sécurité : celles-ci ne s'appliquent donc qu'aux
 * accès directs depuis un client (SDK web, Flutter, curl avec une clé d'API).
 *
 * L'application mobile ne parle qu'à l'API, jamais à Firestore directement.
 * On refuse donc tout accès client : c'est le comportement voulu, pas un
 * verrouillage temporaire. Autoriser une lecture ici exposerait les hashs de
 * mots de passe et les jetons de session.
 *
 * Si un accès direct devient nécessaire (écoute temps réel côté application),
 * ouvrir une collection précise avec des conditions explicites — jamais cette
 * règle globale.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
