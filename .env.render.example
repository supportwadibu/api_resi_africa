# =============================================================================
# Variables d'environnement — API RESI, deploiement Render (Docker)
# =============================================================================
#
# Genere depuis `start/env.ts`, qui declare et valide chaque variable : c'est
# la source de verite, ce fichier en est le reflet.
#
# Les variables marquees REQUISE empechent le serveur de demarrer si elles
# manquent — la validation echoue au boot, pas au premier appel.
#
# A reporter dans Render : Dashboard > le service > Environment.
# Ne JAMAIS commiter ce fichier une fois rempli.


# -----------------------------------------------------------------------------
# Node — REQUISES
# -----------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# PORT et HOST : Render injecte lui-meme PORT et l'ecoute sur 0.0.0.0.
# Les laisser tels quels ; ne pas forcer PORT a une autre valeur.
PORT=3333
HOST=0.0.0.0


# -----------------------------------------------------------------------------
# Application — REQUISES
# -----------------------------------------------------------------------------

# Cle de chiffrement des cookies et de la session. 32 caracteres minimum.
# A generer une fois : `node ace generate:key`. Ne jamais la reutiliser d'un
# environnement a l'autre — la changer invalide toutes les sessions en cours.
APP_KEY=

# URL publique du service, telle que Render l'expose.
APP_URL=https://votre-service.onrender.com

SESSION_DRIVER=cookie


# -----------------------------------------------------------------------------
# Firebase — FIREBASE_DATABASE_URL REQUISE
# -----------------------------------------------------------------------------

# Les OTP et les tentatives d'authentification vivent en Realtime Database :
# sans cette URL, l'inscription et la limitation de debit tombent.
FIREBASE_DATABASE_URL=https://votre-projet-default-rtdb.firebaseio.com

# Compte de service, JSON complet sur UNE seule ligne.
# Secret serveur : ne doit jamais atteindre le mobile.
# En local, on peut lui preferer GOOGLE_APPLICATION_CREDENTIALS pointant vers
# un fichier — le SDK le lit seul, sans passer par `env.ts`.
FIREBASE_SERVICE_ACCOUNT=

# Utile seulement en mode ADC, ou le projet n'est pas deduit du compte.
# FIREBASE_PROJECT_ID=


# -----------------------------------------------------------------------------
# JWT — REQUISES
# -----------------------------------------------------------------------------

# Deux secrets DISTINCTS. Les confondre permettrait a un jeton de
# rafraichissement de passer pour un jeton d'acces.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# -----------------------------------------------------------------------------
# Cloudinary — pieces d'identite, photos d'annonces, rapports PDF
# -----------------------------------------------------------------------------
#
# Optionnelles au demarrage : une instance qui ne traite aucun depot (worker,
# cron) n'a pas a les porter. Leur absence est signalee au premier envoi.
#
# ATTENTION : les rapports et les pieces d'identite partent en mode
# `authenticated` et ne sont lisibles que par URL signee a duree limitee. Cela
# suppose que la token-based authentication soit ACTIVE sur le compte
# Cloudinary (offre Advanced et au-dela). Sans elle, Cloudinary rend une URL
# signee SANS expiration : le mobile croit le lien perissable alors qu'il ne
# l'est pas, sur un document qui porte le chiffre d'affaires du proprietaire
# et les coordonnees de ses clients. A confirmer avant la mise en service.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_DOCUMENTS_FOLDER=resi/owner-documents
CLOUDINARY_PROPERTIES_FOLDER=resi/properties
CLOUDINARY_REPORTS_FOLDER=resi/reports


# -----------------------------------------------------------------------------
# Rendu PDF des rapports
# -----------------------------------------------------------------------------
#
# Chemin du binaire Chromium installe par l'image Docker (apt).
#
# Sans lui, Puppeteer cherche le navigateur qu'il telecharge dans
# `~/.cache/puppeteer`, HORS du projet : un hebergeur qui reconstruit
# l'environnement d'execution apres le build perd ce cache, et chaque rapport
# echoue au lancement du navigateur. C'est la cause de l'erreur
# `report_generation_failed` sur un service Node natif.

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# -----------------------------------------------------------------------------
# Google Sign-In
# -----------------------------------------------------------------------------
#
# Audiences acceptees pour l'ID token, separees par des virgules. Le client
# Android, iOS et web ont chacun leur client_id ; tous doivent figurer ici,
# sinon la verification d'audience echoue.

GOOGLE_CLIENT_IDS=


# -----------------------------------------------------------------------------
# Taches planifiees
# -----------------------------------------------------------------------------
#
# Protege les routes `/api/v1/cron/*`, appelees par un ordonnanceur externe.
# Ces routes sont publiques par nature — aucun JWT ne peut etre presente par un
# appelant automatise — donc ce secret partage est leur seule protection.
# Sans lui, elles sont refusees.

CRON_SECRET=


# -----------------------------------------------------------------------------
# Paiements Wave
# -----------------------------------------------------------------------------

WAVE_API_KEY=
WAVE_BASE_URL=https://api.wave.com
WAVE_WEBHOOK_SECRET=
WAVE_CURRENCY=XOF


# -----------------------------------------------------------------------------
# Limitation de debit OTP
# -----------------------------------------------------------------------------

OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5


# -----------------------------------------------------------------------------
# Notifications — identite de l'expediteur
# -----------------------------------------------------------------------------

APP_NAME=RESI
SMS_SENDER_ID=RESI


# -----------------------------------------------------------------------------
# Messagerie (SMS / WhatsApp)
# -----------------------------------------------------------------------------
#
# MESSAGING_PROVIDER : console | africas_talking | bottom_line | infobip | orange
# `console` ecrit le message dans les logs au lieu de l'envoyer — utile en
# recette, jamais en production.
#
# Ne remplir que le bloc du fournisseur retenu.

MESSAGING_PROVIDER=africas_talking
MESSAGING_PREFERRED_CHANNEL=sms

# --- Africa's Talking ---
AT_API_KEY=
AT_USERNAME=
AT_SMS_FROM=
AT_WHATSAPP_FROM=
AT_BASE_URL=https://api.africastalking.com
AT_WHATSAPP_BASE_URL=

# --- Infobip ---
# INFOBIP_BASE_URL=
# INFOBIP_API_KEY=
# INFOBIP_SMS_FROM=
# INFOBIP_WHATSAPP_FROM=

# --- Orange Developer ---
# ORANGE_CLIENT_ID=
# ORANGE_CLIENT_SECRET=
# ORANGE_SENDER_ADDRESS=
# ORANGE_SENDER_NAME=
# ORANGE_BASE_URL=

# --- Bottom Line (WhatsApp BSP) ---
# BOTTOMLINE_BASE_URL=
# BOTTOMLINE_API_KEY=
# BOTTOMLINE_WHATSAPP_FROM=


# =============================================================================
# Variables qui ne servent a rien — ne pas les reporter
# =============================================================================
#
# Elles figurent dans `.env.production.example` mais aucun code ne les lit.
# Les renseigner donne l'illusion de configurer quelque chose :
#
#   CORS_ORIGIN  `config/cors.ts` ignore cette variable : l'origine est en dur
#                (`[]` en production, tout autorise en developpement). Pour
#                changer le comportement CORS, il faut modifier le fichier.
#
#   TZ           Aucun code ne la lit. Le fuseau du produit (`Africa/Abidjan`)
#                est fixe en dur dans `app/features/reports/report_period.ts`.
