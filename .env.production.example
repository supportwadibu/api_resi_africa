# Environnement de PRODUCTION de l'API — modèle versionné, sans aucun secret.
#
# Ces valeurs se saisissent dans le tableau de bord de l'hébergeur (Render :
# Environment), jamais dans un fichier poussé sur git. `render.yaml` déclare
# déjà les variables non secrètes et génère APP_KEY, les secrets JWT et
# CRON_SECRET ; il ne reste à coller que les lignes marquées « SECRET ».
#
# Le détail de chaque variable est documenté dans `start/env.ts`.

# ── Node
TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# ── Application
# SECRET — généré par Render (`generateValue`). Ne plus le changer ensuite :
# les cookies chiffrés deviendraient illisibles.
APP_KEY=
APP_URL=https://api.resi.africa
APP_NAME=RESI
# Wave y renvoie le propriétaire après un paiement d'abonnement.
SITE_URL=https://resi.africa

# ── Sécurité HTTP
# Vide : le mobile est natif et le back-office appelle l'API depuis son serveur.
CORS_ALLOWED_ORIGINS=
# Render place un proxy devant le conteneur. À vérifier après le premier
# déploiement : l'IP du journal d'audit doit être la vôtre (comparer avec
# https://ifconfig.me). Une IP Cloudflare (104.x, 172.64-71.x) → passer à 2.
TRUST_PROXY=1
AUDIT_LOG_RETENTION_DAYS=180

# ── Session
SESSION_DRIVER=cookie

# ── JWT — SECRET, générés par Render. 32 caractères minimum, deux valeurs
# distinctes. Les changer déconnecte tous les utilisateurs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Firebase
# SECRET — contenu intégral du fichier de compte de service, sur UNE ligne :
#   node -e "process.stdout.write(JSON.stringify(require('./service.json')))"
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://resi-5c32a-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=resi-5c32a

# ── Google Sign-In : client OAuth « Web » (le `serverClientId` du mobile)
GOOGLE_CLIENT_IDS=985472923092-22afjagqr55i117gtq2cl6hp0n2mma75.apps.googleusercontent.com

# ── Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SECRET
CLOUDINARY_API_SECRET=
CLOUDINARY_DOCUMENTS_FOLDER=resi/owner-documents
CLOUDINARY_PROPERTIES_FOLDER=resi/properties

# ── Rapports PDF : PUPPETEER_EXECUTABLE_PATH est posé par le Dockerfile.

# ── Tâches planifiées : ordonnanceur interne, une seule instance.
# CRON_SECRET (SECRET, généré par Render) protège les déclenchements manuels
# de /api/v1/cron/*.
CRON_SECRET=
ENABLE_CRON_JOBS=true
CRON_TIMEZONE=Africa/Abidjan

# ── Administrateurs créés au démarrage — SECRET
# [{"full_name":"…","email":"…","password":"…"}]
BOOTSTRAP_ADMINS=

# ── Wave
# SECRET
WAVE_API_KEY=
WAVE_BASE_URL=https://api.wave.com
# SECRET — absent : tout webhook Wave est refusé, aucun paiement n'aboutit.
WAVE_WEBHOOK_SECRET=
# SECRET — seulement si la clé API a été créée avec la signature activée.
WAVE_API_SIGNING_SECRET=
WAVE_CURRENCY=XOF
WAVE_TEST_ENABLED=false

# ── Quotas OTP
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

# ── E-mails (Resend, domaine resi.africa vérifié)
MAIL_PROVIDER=resend
MAIL_FROM=Resi <no-reply@resi.africa>
MAIL_REPLY_TO=support@resi.africa
MAIL_TEMPLATE_OTP_VERIFICATION=otp_email_verification
MAIL_TEMPLATE_EMAIL_VERIFIED=email_verified
MAIL_APP_URL=https://resi.africa
MAIL_SUPPORT_EMAIL=support@resi.africa
# SECRET
RESEND_API_KEY=

# ── OTP téléphone : DUGU Sender, WhatsApp (son SMS ne dessert pas la CI)
MESSAGING_PROVIDER=dugu_sender
MESSAGING_PREFERRED_CHANNEL=whatsapp
# SECRET — une clé `dsk_live_…` : une `dsk_test_…` n'envoie rien.
DUGU_API_KEY=
DUGU_PROJECT_ID=
