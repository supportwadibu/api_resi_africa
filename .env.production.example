#======================================================================
# RESI API — Variables d'environnement serveur (production)
#======================================================================
# Référence : start/env.ts (schéma de validation au démarrage).
# Les variables marquées [REQUIS] font échouer le boot si absentes.
# Ne jamais committer les valeurs réelles : ce fichier est un modèle.
#======================================================================

#----------------------------------------------------------------------
# Node / runtime                                                [REQUIS]
#----------------------------------------------------------------------
NODE_ENV=production
# Port d'écoute. Sur Cloud Run / Railway / Render, la plateforme impose
# sa propre valeur via $PORT : ne pas la forcer.
PORT=3333
# 0.0.0.0 est obligatoire en conteneur, sinon le service n'est pas joignable.
HOST=0.0.0.0
TZ=UTC
# trace | debug | info | warn | error — 'info' en prod, 'debug' est verbeux
# et peut faire fuiter des données de requête dans les logs.
LOG_LEVEL=info

#----------------------------------------------------------------------
# Application                                                   [REQUIS]
#----------------------------------------------------------------------
# Clé de chiffrement AdonisJS (cookies, signatures, encryption service).
# Générer : node ace generate:key
# La changer invalide tous les cookies et URLs signées existants.
APP_KEY=

# URL publique de l'API, sans slash final. Sert de base aux URLs générées.
APP_URL=https://api.example.com

# Nom affiché dans les notifications (SMS/WhatsApp). Défaut : "Resi".
APP_NAME=Resi

# Pilote de session — seule valeur acceptée par le schéma.
SESSION_DRIVER=cookie

#----------------------------------------------------------------------
# CORS
#----------------------------------------------------------------------
# ATTENTION : config/cors.ts ne lit PAS cette variable aujourd'hui.
# En production l'origine est codée en dur à [] (aucune origine autorisée).
# Sans effet pour un client mobile (pas de politique CORS navigateur), mais
# tout front web nécessitera une modification de config/cors.ts.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

#----------------------------------------------------------------------
# JWT — authentification                                        [REQUIS]
#----------------------------------------------------------------------
# Deux secrets DISTINCTS, longs et aléatoires. Les réutiliser à l'identique
# permettrait de présenter un refresh token comme un access token.
# Générer chacun :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Durées de vie (format 15m, 2h, 30d). Optionnelles.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

#----------------------------------------------------------------------
# Firebase — Firestore + Realtime Database
#----------------------------------------------------------------------
# Compte de service : JSON intégral sur UNE seule ligne.
# En production c'est la méthode à privilégier (pas de fichier à déployer).
# L'encodage base64 n'est PAS supporté par le code : passer le JSON brut.
# Alternative : laisser vide et fournir GOOGLE_APPLICATION_CREDENTIALS
# (chemin vers le .json) — mode Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=

# [REQUIS] URL de la Realtime Database. Les OTP et le rate-limit d'auth y
# sont stockés : sans elle, inscription et connexion tombent.
# L'URL dépend de la région :
#   us-central1  -> https://<id>-default-rtdb.firebaseio.com
#   europe-west1 -> https://<id>-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=https://resi-5c32a-default-rtdb.firebaseio.com

# Utile uniquement en mode ADC, où le projet n'est pas déduit du compte.
FIREBASE_PROJECT_ID=resi-5c32a

# Chemin du fichier de compte de service — mode ADC seulement.
# Laisser vide si FIREBASE_SERVICE_ACCOUNT est renseigné.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

#----------------------------------------------------------------------
# Google Sign-In
#----------------------------------------------------------------------
# Audiences acceptées pour l'ID token, séparées par des virgules.
# Lister TOUS les client_id OAuth utilisés, sinon la vérification d'audience
# échoue pour les clients manquants :
#   - Android : client_id de type "Android"
#   - iOS     : client_id de type "iOS"
#   - Web     : requis par google_sign_in sur Android (serverClientId)
GOOGLE_CLIENT_IDS=

#----------------------------------------------------------------------
# Cloudinary — pièces d'identité et photos d'annonces
#----------------------------------------------------------------------
# Settings > API Keys sur le tableau de bord Cloudinary.
# Optionnelles au démarrage (une instance worker/cron n'en a pas besoin),
# mais requises dès qu'un dépôt de dossier ou une photo est envoyé.
# Les justificatifs sont déposés en mode `authenticated` (URLs signées de
# 15 min), les photos d'annonces en `upload` (publiques).
# CLOUDINARY_API_SECRET ne doit JAMAIS être exposé à l'app mobile.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dossiers racines — défauts appliqués si absents.
CLOUDINARY_DOCUMENTS_FOLDER=resi/owner-documents
CLOUDINARY_PROPERTIES_FOLDER=resi/properties

#----------------------------------------------------------------------
# Tâches planifiées (cron)
#----------------------------------------------------------------------
# Secret protégeant /api/v1/cron/*, appelées par un ordonnanceur externe
# (cron-job.org, Cloud Scheduler). Transmis en en-tête `X-Cron-Secret`
# ou en query `?secret=`.
# Sans cette variable les routes répondent 503 : elles déclenchent des
# écritures en masse et ne doivent pas être ouvertes par défaut.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

#----------------------------------------------------------------------
# Wave — paiements de réservation
#----------------------------------------------------------------------
# Requises dès que le paiement est activé ; leur absence n'empêche pas le boot.
WAVE_API_KEY=
# Vérifie la signature des webhooks entrants. Sans lui, un webhook falsifié
# pourrait marquer une réservation comme payée : à renseigner en production.
WAVE_WEBHOOK_SECRET=
# Défauts appliqués si absents : https://api.wave.com et XOF.
WAVE_BASE_URL=https://api.wave.com
WAVE_CURRENCY=XOF

#----------------------------------------------------------------------
# OTP / rate limiting d'authentification
#----------------------------------------------------------------------
# Défauts si absents : fenêtre 15 minutes, 5 tentatives max.
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5

#----------------------------------------------------------------------
# Messaging (SMS / WhatsApp) — sélection du provider
#----------------------------------------------------------------------
# console | africas_talking | bottom_line | infobip | orange
# Défaut : console — les messages sont seulement journalisés, AUCUN SMS
# n'est envoyé. À changer impérativement en production.
MESSAGING_PROVIDER=africas_talking

# Canal préféré quand le canal utilisateur est 'phone'. sms | whatsapp
MESSAGING_PREFERRED_CHANNEL=sms

# Identifiant d'expéditeur SMS. Défaut : la valeur d'APP_NAME.
SMS_SENDER_ID=Resi

# --- Africa's Talking (si MESSAGING_PROVIDER=africas_talking) ---
# AT_API_KEY et AT_USERNAME sont obligatoires pour ce provider :
# leur absence lève une erreur à la construction du provider.
AT_API_KEY=
AT_USERNAME=
AT_SMS_FROM=
AT_WHATSAPP_FROM=
# Surcharges d'URL — laisser vide pour les endpoints par défaut.
AT_BASE_URL=
AT_WHATSAPP_BASE_URL=

# --- Infobip (si MESSAGING_PROVIDER=infobip) ---
# INFOBIP_BASE_URL et INFOBIP_API_KEY sont obligatoires pour ce provider.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=

# --- Orange Developer (si MESSAGING_PROVIDER=orange) ---
# CLIENT_ID, CLIENT_SECRET et SENDER_ADDRESS sont obligatoires.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
ORANGE_SENDER_NAME=
ORANGE_BASE_URL=

# --- Bottom Line, WhatsApp BSP (si MESSAGING_PROVIDER=bottom_line) ---
# Les trois sont obligatoires pour ce provider.
BOTTOMLINE_BASE_URL=
BOTTOMLINE_API_KEY=
BOTTOMLINE_WHATSAPP_FROM=

#----------------------------------------------------------------------
# Variables obsolètes — à NE PAS reporter en production
#----------------------------------------------------------------------
# Présentes dans le .env local mais lues nulle part dans le code :
#   BREVO_API_KEY, MAIL_FROM_ADDRESS,
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
# L'envoi de messages passe désormais par MESSAGING_PROVIDER ci-dessus.
